<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.newhorizon</groupId>
        <artifactId>nh-base</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <scm>
        <url>https://github.com/New-Horizon-NH/nh-api-gateway</url>
        <connection>git://github.com/New-Horizon-NH/nh-api-gateway.git</connection>
        <developerConnection>git@github.com:New-Horizon-NH/nh-api-gateway.git</developerConnection>
    </scm>
    <issueManagement>
        <system>Github Issues</system>
        <url>https://github.com/New-Horizon-NH/nh-api-gateway/issues</url>
    </issueManagement>
    <ciManagement>
        <system>Github Actions</system>
        <url>https://github.com/New-Horizon-NH/nh-api-gateway/actions</url>
    </ciManagement>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/New-Horizon-NH/nh-api-gateway</url>
        </repository>
    </distributionManagement>
    <licenses>
        <license>
            <name>MIT license</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <repositories>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/New-Horizon-NH/</url>
            <layout>default</layout>
        </repository>
    </repositories>

    <artifactId>nh-api-gateway-bom</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>application</module>
    </modules>

    <properties>
        <nh-web-starter.version>0.0.1-SNAPSHOT</nh-web-starter.version>
        <maven-deploy.skip>true</maven-deploy.skip>
    </properties>
</project>
